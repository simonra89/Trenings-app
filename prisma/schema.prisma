generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  exercises    Exercise[]
  programs     Program[]
  workouts     Workout[]
  stats        ExerciseStat[]
}

model Exercise {
  id               String               @id @default(cuid())
  userId           String?
  user             User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  category         ExerciseCategory
  notes            String?
  isArchived       Boolean              @default(false)
  programExercises ProgramDayExercise[]
  workoutExercises WorkoutExercise[]
  stats            ExerciseStat[]
  @@unique([userId, name])
}

model Program {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  days        ProgramDay[]
  createdAt   DateTime     @default(now())
}

model ProgramDay {
  id        String               @id @default(cuid())
  programId String
  program   Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  exercises ProgramDayExercise[]
}

model ProgramDayExercise {
  id          String    @id @default(cuid())
  programDayId String
  programDay   ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  order        Int
  targetSets   Int?
  targetReps   Int?
  notes        String?
}

model Workout {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  notes      String?
  createdAt  DateTime          @default(now())
  exercises  WorkoutExercise[]
  stats      ExerciseStat[]
}

model WorkoutExercise {
  id         String  @id @default(cuid())
  workoutId  String
  workout    Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  order      Int
  sets       Set[]
}

model Set {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  order             Int
  weightKg          Float
  reps              Int
  rir               Int?
  note              String?
}

model ExerciseStat {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id])
  workoutId       String
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  bestEstimated1RM Float
  volume          Float
  computedAt      DateTime @default(now())

  @@unique([userId, exerciseId, workoutId])
}

enum ExerciseCategory {
  push
  pull
  legs
  upper
  lower
  annet
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
